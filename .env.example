# Copy this file to .env and fill in your values
# cp .env.example .env

# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Application
NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info

# ── LaboCQ Flask settings ──────────────────────────────────────────────────

# REQUIRED — Flask session secret (use a long random string in production)
SECRET_KEY=labocq-dev-secret-changeme

# OPTIONAL — Path to the SQLite database file.
# Render: set to /data/labo_cq.db  (persistent disk mounted at /data)
# Railway: set to /data/labo_cq.db (after adding a Volume at /data in the UI)
# Local:   defaults to ~/labo_cq_data/labo_cq.db if not set
DB_PATH=
